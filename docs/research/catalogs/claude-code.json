        "Notification",
        "SessionEnd",
        "PreCompact",
        "PostCompact"
      ],
      "examples_exhaustive": false,
      "progress_for_these": "Command handler runs longer than one second and emits output.",
      "response_for_these": "Only background handler completion.",
      "interactive_cli_attach_verified": false
    },
    "stable_config_identity_mapping_verified": false
  },
