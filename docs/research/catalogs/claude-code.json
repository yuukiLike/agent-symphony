      "session_id",
      "uuid",
      "hook_name",
      "hook_event"
    ],
    "response_fields": [
      "outcome",
      "exit_code"
    ],
    "source": "https://code.claude.com/docs/en/agent-sdk/typescript#sdkhookstartedmessage",
