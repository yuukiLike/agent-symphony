{
  "name": "agent-symphony",
  "version": "0.1.0",
  "description": "A local, passive dsh execution recorder with an audible event timeline.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=24.0.0" },
  "packageManager": "pnpm@11.14.0",
  "bin": { "agent-symphony": "./bin/symphony.mjs" },
  "scripts": {
    "start": "node bin/symphony.mjs",
    "dev": "node --watch bin/symphony.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "test:integration": "node scripts/test-dsh-integration.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format-catalog": "0.1.6-alpha.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
